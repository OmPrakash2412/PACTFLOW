{
  "name": "pactflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "PACTFLOW - AI-powered agreement, deliverable verification, and PayPal settlement coordination",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dv": "node scripts/dev.js",
    "dev:all": "node scripts/dev.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "test:backend": "python -m pytest backend/tests -v",
    "pdf": "python generate_architecture_pdf.py"
  }
}
